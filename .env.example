# Default remains representative-only until a controlled published listing
# passes the live WordPress/Directorist mapping and location-semantics gate.
MLG_DIRECTORY_SOURCE=representative

# The live adapter is staged in code but intentionally double-locked.
# Do not set this true until the canonical launch/data gate explicitly accepts it.
MLG_LIVE_DIRECTORY_ACCEPTED=false

# Optional override for the canonical WordPress origin used by the staged adapter.
MLG_WORDPRESS_ORIGIN=https://marylandlocalguide.com
